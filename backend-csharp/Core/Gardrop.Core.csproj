<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain + Application layer (Clean Architecture-ın mərkəzi).
       Application qatı persistence abstraksiyası (IAppDbContext → DbSet<T>) üçün yalnız
       EF Core abstraksiyalarına istinad edir; konkret provider (Npgsql) Infrastructure-dadır. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gardrop.Core</RootNamespace>
    <AssemblyName>Gardrop.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>

</Project>

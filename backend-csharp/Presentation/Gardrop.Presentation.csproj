<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Presentation layer (API host). Infrastructure-a istinad edir; giriş nöqtəsi Program.cs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gardrop.Presentation</RootNamespace>
    <AssemblyName>Gardrop.Api</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Sirlər repo-dan kənar saxlanılır (dev: user-secrets, prod: env dəyişənləri). -->
    <UserSecretsId>gardrop-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Transitive Microsoft.OpenApi 2.0.0 (GHSA-v5pm-xwqc-g5wc HIGH) patched versiyaya qaldırılır. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <!-- EF Core Tools (migrations) startup layihəsində Design tələb edir; dev-time, PrivateAssets. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Gardrop.Infrastructure.csproj" />
  </ItemGroup>

</Project>

[Unit]
Description=Gardrop Next.js storefront
After=network.target gardrop-api.service

[Service]
WorkingDirectory=/var/www/gardrop/frontend-next
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
SyslogIdentifier=gardrop-next
User=www-data
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=API_BASE_URL=http://127.0.0.1:3001
Environment=SITE_URL=https://gardrop.az
Environment=NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME

[Install]
WantedBy=multi-user.target
